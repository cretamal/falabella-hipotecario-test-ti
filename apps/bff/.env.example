# Todas son opcionales; estos son los valores por defecto.
PORT=3000
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
POKEAPI_TIMEOUT_MS=5000
# SPRITES_BASE_URL=https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon
# Si se define, la caché usa memoria + Redis:
# REDIS_URL=redis://localhost:6379
CACHE_INDEX_TTL_MS=86400000
CACHE_DETAIL_TTL_MS=86400000
CACHE_DETAIL_STALE_MS=604800000
CACHE_LABEL_TTL_MS=86400000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=240
# Detrás de un proxy de confianza (p. ej. el servidor SSR en Docker): TRUST_PROXY=1
# TRUST_PROXY=false
